generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  Active
  Suspended
}

enum ProductGroup {
  Food
  Shampoo
  Other
}

enum GroomingStatus {
  Pending
  Confirmed
  Completed
  Cancelled
}
enum BookingType {
  Salon
  Home_Service @map("Home Service")
}
enum ProductReservationStatus {
  Pending
  Confirmed
  Ready_for_Pickup @map("Ready for Pickup")
  Claimed
  Cancelled
}

model User {
  id              Int           @id @default(autoincrement())
  role            String        @default("User") @db.VarChar(50)
  accountStatus   AccountStatus @default(Active) @map("account_status")
  username        String?       @unique @db.VarChar(100)
  surname         String?       @db.VarChar(100)
  firstName       String?       @map("first_name") @db.VarChar(100)
  middleInitial   String?       @map("middle_initial") @db.VarChar(2)
  phoneNumber     String?       @map("phone_number") @db.VarChar(20)
  email           String        @unique @db.VarChar(150)
  emailVerifiedAt DateTime      @default(now()) @map("email_verified_at")
  password        String        @db.VarChar(255)
  failedAttempts  Int?          @default(0) @map("failed_attempts")
  lockoutTime     DateTime?     @map("lockout_time")
  resetToken      String?       @map("reset_token") @db.VarChar(255)
  resetExpires    DateTime?     @map("reset_expires")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("users")
}

model Customer {
  id                  Int                  @id @default(autoincrement())
  customerName        String               @map("customer_name") @db.VarChar(150)
  email               String?              @db.VarChar(150)
  phone               String               @db.VarChar(50)
  address             String?              @db.Text
  photoPath           String?              @map("photo_path") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at")
  pets                Pet[]
  appointments        GroomingAppointment[]
  productReservations ProductReservation[]

  @@map("customers")
}

model Pet {
  id           Int                   @id @default(autoincrement())
  customerId   Int                   @map("customer_id")
  petName      String                @map("pet_name") @db.VarChar(100)
  breed        String?               @db.VarChar(100)
  species      String?               @db.VarChar(50)
  photoPath    String?               @map("photo_path") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at")
  customer     Customer              @relation(fields: [customerId], references: [id])
  appointments GroomingAppointment[]

  @@map("pets")
}

model Product {
  productId      Int                      @id @default(autoincrement()) @map("product_id")
  sku            String?                  @unique @db.VarChar(40)
  productName    String                   @map("product_name") @db.VarChar(150)
  category       String                   @db.VarChar(100)
  productGroup   ProductGroup             @default(Other) @map("product_group")
  price          Decimal                  @db.Decimal(10, 2)
  stockQuantity  Int                      @default(0) @map("stock_quantity") @db.UnsignedInt
  reorderLevel   Int                      @default(5) @map("reorder_level") @db.UnsignedInt
  isActive       Boolean                  @default(true) @map("is_active")
  description    String?                  @db.Text
  image          String?                  @db.VarChar(255)
  createdAt      DateTime                 @default(now()) @map("created_at")
  reservationItems ProductReservationItem[]

  @@map("products")
}

model GroomingStyle {
  styleId      Int                    @id @default(autoincrement()) @map("style_id")
  styleName    String                 @map("style_name") @db.VarChar(100)
  prices       StyleSizePricing[]
  appointments GroomingAppointment[]

  @@map("grooming_styles")
}

model StyleSizePricing {
  pricingId Int           @id @default(autoincrement()) @map("pricing_id")
  styleId   Int           @map("style_id")
  petSize   String        @map("pet_size") @db.VarChar(50)
  price     Decimal       @db.Decimal(10, 2)
  style     GroomingStyle @relation(fields: [styleId], references: [styleId], onDelete: Cascade)

  @@map("style_size_pricing")
}

model GroomingAddon {
  addonId   Int      @id @default(autoincrement()) @map("addon_id")
  addonName String   @map("addon_name") @db.VarChar(100)
  price     Decimal  @db.Decimal(10, 2)

  @@map("grooming_addons")
}

model Groomer {
  groomerId   Int                    @id @default(autoincrement()) @map("groomer_id")
  groomerName String                 @unique @map("groomer_name") @db.VarChar(100)
  isActive    Boolean                @default(true) @map("is_active")
  createdAt   DateTime               @default(now()) @map("created_at")
  appointments GroomingAppointment[]

  @@map("groomers")
}

model GroomingAppointment {
  appointmentId  BigInt         @id @default(autoincrement()) @map("appointment_id") @db.UnsignedBigInt
  reservationCode String        @unique @map("reservation_code") @db.VarChar(24)
  customerId     Int            @map("customer_id")
  petId          Int            @map("pet_id")
  groomingStyleId Int           @map("grooming_style_id")
  groomerId      Int            @map("groomer_id")
  bookingType    BookingType    @default(Salon) @map("booking_type")
  serviceAddress String?        @map("service_address") @db.Text
  petSize        String         @map("pet_size") @db.VarChar(50)
  appointmentDate DateTime      @map("appointment_date") @db.Date
  appointmentTime DateTime      @map("appointment_time") @db.Time(0)
  specialInstructions String?   @map("special_instructions") @db.Text
  totalPrice     Decimal        @map("total_price") @db.Decimal(10,2)
  status         GroomingStatus @default(Pending)
  cancelledAt    DateTime?      @map("cancelled_at")
  confirmationEmailSentAt DateTime? @map("confirmation_email_sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")
  customer       Customer       @relation(fields:[customerId], references:[id])
  pet            Pet            @relation(fields:[petId], references:[id])
  style          GroomingStyle  @relation(fields:[groomingStyleId], references:[styleId])
  groomer        Groomer        @relation(fields:[groomerId], references:[groomerId])

  @@map("grooming_appointments")
}

model ProductReservation {
  reservationId   BigInt                   @id @default(autoincrement()) @map("reservation_id") @db.UnsignedBigInt
  reservationCode String                   @unique @map("reservation_code") @db.VarChar(24)
  customerId      Int                      @map("customer_id")
  totalAmount     Decimal                  @map("total_amount") @db.Decimal(10,2)
  status          ProductReservationStatus @default(Pending)
  reservedUntil   DateTime                 @map("reserved_until")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at")
  customer        Customer                 @relation(fields:[customerId], references:[id])
  items           ProductReservationItem[]

  @@map("product_reservations")
}

model ProductReservationItem {
  reservationItemId BigInt             @id @default(autoincrement()) @map("reservation_item_id") @db.UnsignedBigInt
  reservationId     BigInt             @map("reservation_id") @db.UnsignedBigInt
  productId         Int                @map("product_id")
  quantity          Int                @db.UnsignedInt
  unitPrice         Decimal            @map("unit_price") @db.Decimal(10,2)
  reservation       ProductReservation @relation(fields:[reservationId], references:[reservationId], onDelete:Cascade)
  product           Product            @relation(fields:[productId], references:[productId])

  @@map("product_reservation_items")
}
